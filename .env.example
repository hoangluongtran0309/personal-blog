# Copy to .env for local development. Never commit .env.

ARTICLES_DIR=./data/articles

# Admin account. ADMIN_PASSWORD_HASH is a BCrypt hash, never the plain password.
# See README.md (Configuration) for how to generate a BCrypt hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

SITE_NAME=Personal Blog
SITE_DESCRIPTION=Notes and articles on software development.
SITE_AUTHOR=Julia Walker
SITE_AUTHOR_ROLE=Web Developer
# Shown under the hero heading; leave empty for the default text.
SITE_TAGLINE=
SITE_HERO_IMAGE=/images/hero.png
SITE_AUTHOR_AVATAR=/images/author.png
# Contact links in the sidebar and footer; empty values are hidden.
SITE_EMAIL=
SOCIAL_GITHUB=
SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
SOCIAL_X=

# Any long random string, e.g. `openssl rand -hex 32`
REMEMBER_ME_KEY=
# false for http://localhost, true behind HTTPS
SESSION_COOKIE_SECURE=false
THYMELEAF_CACHE=false
